<!DOCTYPE html>
<html>
  <head>
    <title>Produtos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
      body { 
        font-family: 'Inter', sans-serif; 
        background: linear-gradient(135deg, #1e1e2f, #3a3a5c); 
        min-height: 100vh; 
        color: #f5f5f5;
      }

      .navbar { 
        background: rgba(0,0,0,0.5); 
        backdrop-filter: blur(8px);
      }

      .card-product {
        background: #27293d;
        border-radius: 12px;
        box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        transition: transform 0.2s, box-shadow 0.2s;
      }

      .card-product:hover {
        transform: translateY(-5px);
        box-shadow: 0 12px 25px rgba(0,0,0,0.45);
      }

      .btn-primary-custom { background: #ff6b6b; border: none; }
      .btn-primary-custom:hover { background: #ff4c4c; }

      .btn-success-custom { background: #4ecdc4; border: none; }
      .btn-success-custom:hover { background: #3ab3a2; }

      .btn-danger-custom { background: #ff9f43; border: none; }
      .btn-danger-custom:hover { background: #ff7f1f; }

      a { text-decoration: none; }

      .form-control, .form-label { background: #3a3a5c; color: #f5f5f5; border: none; }
      .form-control:focus { background: #3a3a5c; color: #f5f5f5; box-shadow: 0 0 0 0.2rem rgba(255, 107, 107, 0.25); }
    </style>
  </head>

  <body>
    <nav class="navbar navbar-expand-lg mb-4 shadow-sm">
      <div class="container">
        <a class="navbar-brand text-white fw-bold" href="<%= products_path %>">Produtos</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to "Produtos", products_path, class: "nav-link text-white fw-medium" %>
            </li>
            <li class="nav-item">
              <%= link_to "Novo Produto", new_product_path, class: "btn btn-success-custom ms-2" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mb-5">
      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
