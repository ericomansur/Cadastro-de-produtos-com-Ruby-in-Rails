<!DOCTYPE html>
<html>
  <head>
    <title>Produtos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    <%= javascript_include_tag "application", "data-turbo-track": "reload", defer: true %>
    <%= stylesheet_link_tag "products", media: "all", "data-turbo-track": "reload" %>


  </head>

  <body>
    <nav class="navbar navbar-expand-lg mb-4 shadow-sm">
      <div class="container">
        <a class="navbar-brand text-white fw-bold" href="<%= products_path %>">Produtos</a>
        <div class="collapse navbar-collapse">
          <ul class="navbar-nav ms-auto">
            <li class="nav-item">
              <%= link_to "Produtos", products_path, class: "nav-link text-white fw-medium" %>
            </li>
            <li class="nav-item">
              <%= link_to "Novo Produto", new_product_path, class: "btn btn-success-custom ms-2" %>
            </li>
          </ul>
        </div>
      </div>
    </nav>

    <div class="container mb-5">
      <%= yield %>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
  </body>
</html>
