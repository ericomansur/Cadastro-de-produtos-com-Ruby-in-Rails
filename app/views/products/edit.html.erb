<div class="row justify-content-center mt-5">
  <div class="col-md-6">
    <div class="card shadow-lg p-4" style="background:white;">
      <h2 class="text-center fw-bold mb-4">
        <%= @product.new_record? ? "Novo Produto" : "Editar Produto" %>
      </h2>

      <% if @product.errors.any? %>
        <div class="alert alert-danger">
          <h6 class="fw-bold">Erros ao salvar produto:</h6>
          <ul>
            <% @product.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @product, local: true do |f| %>
        <div class="mb-3">
          <%= f.label :name, "Nome do Produto", class: "form-label fw-medium" %>
          <%= f.text_field :name, class: "form-control", placeholder: "Digite o nome", style: "background:white; color:black;" %>
        </div>

        <div class="mb-3">
          <%= f.label :price, "Preço (R$)", class: "form-label fw-medium" %>
          <%= f.number_field :price, step: 0.01, class: "form-control", placeholder: "0.00", style: "background:white; color:black;" %>
        </div>

        <div class="d-flex justify-content-between">
          <%= f.submit @product.new_record? ? "Salvar" : "Atualizar", class: "btn btn-success fw-bold" %>
          <%= link_to "Cancelar", products_path, class: "btn btn-danger fw-bold" %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<style>
body { background: #e4e9f0; font-family: 'Poppins', sans-serif; padding: 2rem; }
.card { transition: transform 0.2s; }
.card:hover { transform: translateY(-5px); }
.btn-success { background: #4ecdc4; border: none; }
.btn-success:hover { background: #3ab3a2; }
.btn-danger { background: #e74c3c; border: none; }
.btn-danger:hover { background: #c0392b; }
</style>
